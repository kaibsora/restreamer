# Docker host group IDs used for /dev/dri and /dev/video* access.
RENDER_GID=109
VIDEO_GID=44

# Optional explicit render nodes for multi-GPU hardware acceptance.
# The corresponding paths must be present inside the container.
RESTREAMER_VAAPI_DEVICE=
RESTREAMER_QSV_DEVICE=
RESTREAMER_VULKAN_DEVICE=0

# Comma-separated host addresses advertised to LAN WebRTC clients.
RESTREAMER_WEBRTC_HOSTS=192.168.1.20,restreamer.lan
