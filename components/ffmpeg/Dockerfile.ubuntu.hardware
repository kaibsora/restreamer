ARG BUILD_IMAGE=nvidia/cuda:12.9.1-devel-ubuntu24.04
# NVENC/NVDEC load the host driver libraries supplied by NVIDIA Container
# Toolkit. FFmpeg isn't linked to CUDA's multi-gigabyte compute runtime, so a
# plain Ubuntu deploy stage retains GPU support without shipping unused cuBLAS,
# cuSPARSE, NCCL, and NPP packages.
ARG DEPLOY_IMAGE=ubuntu:24.04

FROM $BUILD_IMAGE AS builder

ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig
ENV SRC=/usr/local
ENV DEBIAN_FRONTEND=noninteractive
ARG BUILD_PACKAGE_EPOCH=local

RUN echo "Package snapshot refresh: ${BUILD_PACKAGE_EPOCH}" && \
  if [ -r /etc/ssl/certs/ca-certificates.crt ]; then \
    sed -i 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g; s|http://security.ubuntu.com|https://security.ubuntu.com|g' /etc/apt/sources.list.d/ubuntu.sources; \
  fi && \
  apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update -y && \
  apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 install -y \
  pkg-config \
  curl \
  libcurl4-openssl-dev \
  git \
  nasm \
  openssl \
  libssl-dev \
  cmake \
  yasm \
  build-essential \
  libtool \
  autoconf \
  glslang-dev \
  glslang-tools \
  libdrm-dev \
  libva-dev \
  libvpl-dev \
  libvulkan-dev \
  libv4l-dev \
  libasound2-dev \
  libx264-dev \
  libx265-dev \
  librav1e-dev \
  libaom-dev \
  libdav1d-dev \
  libvpx-dev \
  libmp3lame-dev \
  libopus-dev \
  libvorbis-dev \
  libogg-dev \
  libfreetype-dev \
  libharfbuzz-dev \
  libsrt-openssl-dev \
  libxml2-dev \
  libxcb1-dev \
  libxcb-xfixes0-dev \
  libxcb-shm0-dev \
  libxcb-shape0-dev \
  zlib1g-dev

# install and patch ffmpeg
ARG FFNVCODEC_VERSION=12.2.72.0
ARG VULKAN_HEADERS_VERSION=1.4.362
ARG FFMPEG_VERSION=none

RUN mkdir -p /dist && cd /dist && \
  curl --fail --location --show-error \
    --retry 8 --retry-all-errors --retry-delay 5 --retry-max-time 180 \
    --connect-timeout 20 \
    --output Vulkan-Headers-${VULKAN_HEADERS_VERSION}.tar.gz \
    https://github.com/KhronosGroup/Vulkan-Headers/archive/refs/tags/v${VULKAN_HEADERS_VERSION}.tar.gz && \
  case "${FFMPEG_VERSION}" in \
    git-[0-9a-f][0-9a-f]*) \
      FFMPEG_SHA="${FFMPEG_VERSION#git-}"; \
      printf '%s' "${FFMPEG_SHA}" | grep -Eq '^[0-9a-f]{40}$' || \
        { echo "Invalid FFmpeg Git commit: ${FFMPEG_SHA}" >&2; exit 2; }; \
      FFMPEG_URL="https://github.com/FFmpeg/FFmpeg/archive/${FFMPEG_SHA}.tar.gz" \
      ;; \
    [0-9]*.[0-9]*) \
      printf '%s' "${FFMPEG_VERSION}" | grep -Eq '^[0-9]+\.[0-9]+(\.[0-9]+)?$' || \
        { echo "Invalid FFmpeg release: ${FFMPEG_VERSION}" >&2; exit 2; }; \
      FFMPEG_URL="https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.gz" \
      ;; \
    *) \
      echo "Invalid resolved FFmpeg source: ${FFMPEG_VERSION}" >&2; \
      exit 2 \
      ;; \
  esac && \
  mkdir -p ffmpeg-${FFMPEG_VERSION} && \
  curl --fail --location --show-error \
    --retry 8 --retry-all-errors --retry-delay 5 --retry-max-time 180 \
    --connect-timeout 20 \
    --output ffmpeg-${FFMPEG_VERSION}.tar.gz \
    "${FFMPEG_URL}" && \
  curl --fail --location --show-error \
    --retry 8 --retry-all-errors --retry-delay 5 --retry-max-time 180 \
    --connect-timeout 20 --remote-name \
    https://github.com/FFmpeg/nv-codec-headers/releases/download/n${FFNVCODEC_VERSION}/nv-codec-headers-${FFNVCODEC_VERSION}.tar.gz && \
  tar -xz -f Vulkan-Headers-${VULKAN_HEADERS_VERSION}.tar.gz && \
  tar -xz -f ffmpeg-${FFMPEG_VERSION}.tar.gz \
    --strip-components=1 --directory ffmpeg-${FFMPEG_VERSION} && \
  tar -xz -f nv-codec-headers-${FFNVCODEC_VERSION}.tar.gz && \
  cp -R Vulkan-Headers-${VULKAN_HEADERS_VERSION}/include/. /usr/local/include/ && \
  rm Vulkan-Headers-${VULKAN_HEADERS_VERSION}.tar.gz ffmpeg-${FFMPEG_VERSION}.tar.gz nv-codec-headers-${FFNVCODEC_VERSION}.tar.gz && \
  cd nv-codec-headers-${FFNVCODEC_VERSION} && \
  make install

COPY ./contrib /contrib

ARG BUILD_DATE=1970-01-01T00:00:00Z
ARG BUILD_COMMIT=unknown

RUN cd /dist/ffmpeg-${FFMPEG_VERSION} && \
  git apply --whitespace=nowarn /contrib/ffmpeg-jsonstats.patch && \
  patch -p1 < /contrib/ffmpeg-hls.patch && \
  ./configure \
  --extra-version="datarhei-${BUILD_COMMIT}-${BUILD_DATE}" \
  --extra-libs="-lpthread -lxml2 -lm -lz -lsupc++ -lstdc++ -lssl -lcrypto -lc -ldl -lcurl" \
  --prefix="${SRC}" \
  --extra-cflags="-I/usr/local/include -I/usr/local/cuda/include" \
  --extra-ldflags=-L/usr/local/cuda/lib64 \
  --enable-gpl \
  --enable-version3 \
  --enable-static \
  --enable-openssl \
  --enable-libxml2 \
  --enable-cuda \
  --enable-nvdec \
  --enable-nvenc \
  --enable-cuvid \
  --enable-libdrm \
  --enable-vaapi \
  --enable-libvpl \
  --enable-vulkan \
  --enable-libv4l2 \
  --enable-libfreetype \
  --enable-libharfbuzz \
  --enable-alsa \
  --enable-libsrt \
  --enable-libx264 \
  --enable-libx265 \
  --enable-libvpx \
  --enable-libmp3lame \
  --enable-libopus \
  --enable-libvorbis \
  --enable-libdav1d \
  --enable-librav1e \
  --enable-libaom \
  --enable-libxcb \
  --disable-ffplay \
  --disable-debug \
  --disable-doc || { grep -n -A20 -B10 -i vulkan ffbuild/config.log | tail -n 240; exit 1; }; \
  make -j$(nproc) && \
  make install && \
  hash -r

RUN mkdir -p /ffmpeglibs && \
  ldd /usr/local/bin/ffmpeg | grep -o -e '/lib/[a-z0-9_]*-linux-gnu/[^ ]*' | xargs -I % cp -v % /ffmpeglibs

# Modified for CQComber Restreamer: retain the exact patched source, build
# instructions, third-party headers and licenses for binary redistribution.
RUN mkdir -p /distribution/ffmpeg /distribution/licenses/builder && \
  cp /dist/ffmpeg-${FFMPEG_VERSION}/ffbuild/config.log /distribution/ffmpeg/config.log && \
  /usr/local/bin/ffmpeg -buildconf > /distribution/ffmpeg/build-configuration.txt 2>&1 && \
  cd /dist/ffmpeg-${FFMPEG_VERSION} && make distclean && \
  tar -cJf /distribution/ffmpeg/ffmpeg-patched-source.tar.xz -C /dist ffmpeg-${FFMPEG_VERSION} \
    nv-codec-headers-${FFNVCODEC_VERSION} Vulkan-Headers-${VULKAN_HEADERS_VERSION} && \
  cp -R /contrib /distribution/ffmpeg/patches && \
  cp LICENSE.md COPYING.* /distribution/ffmpeg/ && \
  for library in /ffmpeglibs/*; do \
    original="/usr/lib/x86_64-linux-gnu/$(basename "$library")"; \
    owner="$(dpkg-query -S "$original" | head -n 1 | sed 's/: \/.*//')"; \
    dpkg-query -W -f '${source:Package}=${source:Version}\n' "$owner"; \
  done | sort -u > /distribution/builder-library-sources.txt && \
  find /usr/share/doc -name copyright -type f -exec cp --parents '{}' /distribution/licenses/builder/ \;

FROM $DEPLOY_IMAGE AS runtime-base

# Bootstrap HTTPS package downloads before ca-certificates is installed below.
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /usr/local/bin/ffmpeg /usr/local/bin/ffmpeg
COPY --from=builder /usr/local/bin/ffprobe /usr/local/bin/ffprobe
COPY --from=builder /ffmpeglibs /ffmpeglibs
COPY ./verify-hardware-build.sh /usr/local/bin/restreamer-verify-ffmpeg

ENV DEBIAN_FRONTEND=noninteractive

RUN echo "/ffmpeglibs" > /etc/ld.so.conf.d/ffmpeg.conf && \
  ldconfig && \
  sed -i 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g; s|http://security.ubuntu.com|https://security.ubuntu.com|g' /etc/apt/sources.list.d/ubuntu.sources && \
  apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=30 update && \
  apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=30 install -y --no-install-recommends \
  ca-certificates \
  openssl \
  tzdata \
  v4l-utils \
  vainfo \
  vulkan-tools \
  fonts-dejavu-core \
  fbset \
  libasound2t64 \
  libdrm2 \
  libva2 \
  libva-drm2 \
  libvpl2 \
  libmfx1 \
  libmfx-gen1.2 \
  intel-media-va-driver-non-free \
  mesa-va-drivers \
  mesa-vulkan-drivers && \
  rm -rf /var/lib/apt/lists/* && \
  chmod +x /usr/local/bin/restreamer-verify-ffmpeg && \
  /usr/local/bin/restreamer-verify-ffmpeg

# Sources are distributed as a separate public OCI image to keep the application
# image small. This stage also supplies bundled FFmpeg source and notices below.
FROM runtime-base AS source-collector
ARG FFMPEG_VERSION
COPY --from=builder /distribution /distribution
COPY Dockerfile.ubuntu.hardware collect-source-packages.sh /distribution/build/
RUN sh /distribution/build/collect-source-packages.sh

FROM scratch AS source-export
COPY --from=source-collector /distribution /sources

FROM runtime-base AS runtime
ARG FFMPEG_SOURCE_IMAGE=local-build-source-export
COPY --from=source-collector /distribution/ffmpeg /usr/share/doc/ffmpeg
COPY --from=source-collector /distribution/licenses /usr/share/doc/ffmpeg/dependency-licenses
COPY --from=source-collector /distribution/SHA256SUMS /usr/share/doc/ffmpeg/source-SHA256SUMS
RUN printf 'Corresponding source container: %s\nCopy /sources from that image. See THIRD_PARTY.md in the application repository.\n' \
    "${FFMPEG_SOURCE_IMAGE}" > /usr/share/doc/ffmpeg/SOURCES.txt
LABEL io.cqcomber.ffmpeg.sources="${FFMPEG_SOURCE_IMAGE}"

ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,video,utility

WORKDIR /tmp
ENTRYPOINT ["/usr/local/bin/ffmpeg"]
CMD ["-version"]
